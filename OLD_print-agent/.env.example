# URL base da API da Kazakora (sem barra no final)
API_BASE_URL=https://kazakora.devlira.com.br

# Mesmo valor de PRINT_AGENT_TOKEN configurado no .env do servidor Laravel
PRINT_AGENT_TOKEN=

# Identifica esta máquina nas reivindicações de job (aparece em print_jobs.claimed_by)
AGENT_ID=mini-pc-expedicao

# Nome exato da impressora tal como aparece em "Impressoras e scanners" do Windows
# (funciona igual pra impressora USB ou impressora de rede — uma vez instalada
# no Windows com o driver certo, ambas aparecem como um nome de impressora comum;
# rode `npm run printers` pra listar os nomes disponíveis nesta máquina)
PRINTER_NAME=

# Intervalo de polling da API, em milissegundos (2000 = 2 segundos)
POLL_INTERVAL_MS=2000

# Redis/Memurai local
REDIS_URL=redis://127.0.0.1:6379

# Configuração de retry da fila de impressão
PRINT_MAX_ATTEMPTS=5
PRINT_BACKOFF_BASE_MS=2000

# Quantos jobs concluídos com sucesso manter no Redis para auditoria
PRINT_KEEP_COMPLETED=100

# TTL (segundos) do controle de idempotência do Poller — 86400 = 24h
DEDUPE_TTL_SECONDS=86400

# Pasta onde os PDFs baixados temporariamente antes de imprimir são gravados
TEMP_DIR=./tmp

LOG_DIR=./logs
LOG_LEVEL=info
