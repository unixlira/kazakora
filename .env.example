APP_NAME=KazaKora
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=America/Sao_Paulo

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=kazakora
DB_USERNAME=kazakora
DB_PASSWORD=secret123

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_CONNECTION=default

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# redis localmente (worker Docker já roda queue:work redis). Em hospedagem
# compartilhada sem Redis real (ex: homolog), usar QUEUE_CONNECTION=database
# + um Cron Job rodando "php artisan queue:work --stop-when-empty" a cada
# minuto — não dá pra manter um worker persistente lá.
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=kazakora_cache

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="loja@kazakora.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

ML_APP_ID=
ML_CLIENT_SECRET=
ML_REDIRECT_URI="${APP_URL}/api/mercadolivre/callback"
ML_WEBHOOK_URL="${APP_URL}/api/mercadolivre/webhook"
ML_API_BASE_URL=https://api.mercadolibre.com
ML_AUTH_URL=https://auth.mercadolivre.com.br/authorization
ML_TOKEN_URL=https://api.mercadolibre.com/oauth/token

# Bling (ponte pro TikTok Shop, pedido explícito 2026-08-31): client_id/
# client_secret vêm de um app cadastrado em Central de Extensões > Área do
# Integrador > Criar aplicativo (dentro da sua conta Bling). Antes de usar,
# conecte o TikTok Shop dentro do próprio Bling (Configuração do TikTok Shop
# no painel Bling) — é lá que a autenticação com o TikTok de fato acontece.
BLING_CLIENT_ID=
BLING_CLIENT_SECRET=
BLING_REDIRECT_URI="${APP_URL}/api/bling/callback"

# Shopee (Open Platform v2): partner_id/partner_key vêm do app cadastrado em
# open.shopee.com/apps — use as variantes SHOPEE_TEST_* enquanto o app ainda
# for de teste/sandbox (host test-stable), troque pras SHOPEE_* "normais" +
# api_base_url de produção quando aprovado. SHOPEE_PUSH_URL precisa ser
# cadastrada como "Test Push Callback URL" no mesmo painel — é contra essa
# URL exata que a assinatura do push é verificada aqui.
SHOPEE_TEST_PARTNER_ID=
SHOPEE_TEST_PARTNER_KEY=
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_REDIRECT_URL="${APP_URL}/api/shopee/callback"
SHOPEE_PUSH_URL="${APP_URL}/api/shopee/webhook"
# Chave separada, gerada pela própria Shopee especificamente pra push —
# aparece no painel deles ao configurar o "Test Push"/"Live Push", não é a
# mesma partner_key usada nas chamadas de API acima.
SHOPEE_PUSH_PARTNER_KEY=
SHOPEE_API_BASE_URL=https://partner.test-stable.shopeemobile.com
# Host do LINK de autorização (diferente do api_base_url acima!). Sandbox
# (padrão abaixo) é sempre o host global — não existe host de sandbox
# regional pro Brasil, apesar do que uma tabela da doc oficial sugere
# (confirmado via DNS: a variante "sandbox...shopee.com.br" não resolve).
# Produção Brasil, essa sim regional de verdade: https://open.shopee.com.br
# Ver ShopeeAuthService::getAuthorizationUrl().
SHOPEE_AUTH_BASE_URL=https://open.test-stable.shopee.com
# Liga log de diagnóstico da assinatura HMAC (base string/sign/fingerprint da
# key, nunca a key crua) em storage/logs/shopee-*.log sem precisar redeploy.
SHOPEE_DEBUG_SIGNING=false

# Selling Partner API (SP-API) — sellercentral.amazon.com.br > Partner Network
# > Develop Apps. AMAZON_LWA_CLIENT_ID é o "Identificador de cliente" do Login
# with Amazon (usado pra trocar/renovar token); AMAZON_APP_ID é o App ID do
# app SP-API (amzn1.sp.solution...), usado só no link de autorização. Um app
# privado (não publicado) também pode gerar um refresh token direto no Seller
# Central sem precisar do redirect OAuth completo (AMAZON_REFRESH_TOKEN, útil
# pra bootstrap/testes em sandbox) — ver AmazonAuthService::connectWithRefreshToken().
AMAZON_LWA_CLIENT_ID=
AMAZON_LWA_CLIENT_SECRET=
AMAZON_APP_ID=
AMAZON_REDIRECT_URI="${APP_URL}/api/amazon/callback"
AMAZON_REFRESH_TOKEN=
AMAZON_SELLER_ID=
# Amazon.com.br — Brasil fica na região "NA" pra fins de endpoint da SP-API.
AMAZON_MARKETPLACE_ID=A2Q3Y263D00KWC
AMAZON_REGION=na
AMAZON_SANDBOX=true
AMAZON_SP_API_BASE_URL=https://sandbox.sellingpartnerapi-na.amazon.com
AMAZON_AUTH_BASE_URL=https://sellercentral.amazon.com.br
AMAZON_AUTH_DRAFT_MODE=true

# Modo Test: chaves em Dashboard do Stripe > Developers > API keys.
# STRIPE_WEBHOOK_SECRET só existe depois de cadastrar o endpoint
# ${APP_URL}/api/stripe/webhook em Developers > Webhooks.
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# Mercado Pago: Access Token (secreto) + Public Key (usada no front-end pra
# tokenizar cartão) vêm de developers.mercadopago.com.br > Suas integrações
# > (aplicação) > Credenciais. Gateway ativo (Stripe|Mercado Pago) é
# escolhido em /admin/pagamentos, não aqui — essas chaves só precisam
# existir pra quem for realmente selecionado.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=

# App OAuth próprio do Mercado Pago (separado do app do Mercado Livre acima,
# mesmo sendo a mesma empresa) — "ID do aplicativo"/"Chave secreta" do painel
# deles. Callback fixo: {APP_URL}/api/mercadopago/callback (rota de
# verificação em routes/api.php já responde 200 pro teste deles).
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=

# NF-e: ambiente "homologacao" (testes, sem valor fiscal) ou "producao".
# O certificado A1 (.pfx) e sua senha são enviados pelo admin em
# /admin/empresa (não ficam mais em .env). NFE_CUF é o código IBGE da UF
# do emitente (35 = SP).
NFE_AMBIENTE=homologacao
NFE_SERIE=1
NFE_CUF=35

# Melhor Envio: cotação real de frete no checkout, via OAuth2 (conectar em
# /admin/logistica). Client ID/Secret vêm de uma Aplicação cadastrada no
# painel deles (sandbox.melhorenvio.com.br ou melhorenvio.com.br > Minhas
# aplicações). Sem conta conectada, o checkout cai de volta pras formas de
# envio estáticas cadastradas em /admin/logistica. Sandbox por padrão — trocar
# as 3 URLs para melhorenvio.com.br (sem "sandbox.") quando for produção.
MELHORENVIO_CLIENT_ID=
MELHORENVIO_CLIENT_SECRET=
MELHORENVIO_REDIRECT_URI="${APP_URL}/api/melhorenvio/callback"
MELHORENVIO_API_BASE_URL=https://sandbox.melhorenvio.com.br/api/v2
MELHORENVIO_AUTH_URL=https://sandbox.melhorenvio.com.br/oauth/authorize
MELHORENVIO_TOKEN_URL=https://sandbox.melhorenvio.com.br/oauth/token

# Token fixo (Bearer) que o agente local de impressão (programa na loja,
# conectado à impressora USB) usa pra falar com /api/print-agent/*. Gere um
# valor aleatório longo (ex: `php artisan tinker --execute="echo Str::random(64);"`)
# e configure o mesmo valor no agente.
PRINT_AGENT_TOKEN=

# Correios (API oficial — Pré-Postagem/QR Code + Preço/Prazo). NUMERO_USUARIO
# é o CNPJ/CPF cadastrado no Meu Correios. As APIs restritas (Preço/Prazo e
# Pré-postagem) exigem token vinculado a contrato/cartão de postagem — cada
# vínculo tem sua PRÓPRIA chave de acesso, gerada separadamente em
# cws.correios.com.br > Gestão de acesso a APIs (não é a senha do site nem
# a mesma chave uma da outra). Confirmado em produção 2026-08-19: um token
# de usuário simples (só CODIGO_ACESSO genérico, sem as 2 chaves escopadas
# abaixo) é rejeitado por essas APIs com GTW-012 "Acesso não autorizado".
# Trocar as URLs para apihom.correios.com.br pra testar em homologação antes
# de ir pra produção.
CORREIOS_NUMERO_USUARIO=
CORREIOS_CODIGO_ACESSO=
CORREIOS_CONTRATO=
CORREIOS_CODIGO_ACESSO_CONTRATO=
CORREIOS_CARTAO_POSTAGEM=
CORREIOS_CODIGO_ACESSO_CARTAO_POSTAGEM=
CORREIOS_DR=
CORREIOS_TOKEN_BASE_URL=https://api.correios.com.br/token
CORREIOS_API_BASE_URL=https://api.correios.com.br/prepostagem
# Produtos "Preço" e "Prazo" — API separada da de Pré-Postagem acima (path
# diferente), usada pra cotar frete real no checkout (CorreiosFreightQuoteService).
# Usa a chave escopada de CONTRATO acima, não a de CARTAO_POSTAGEM.
CORREIOS_PRECO_BASE_URL=https://api.correios.com.br/preco
CORREIOS_PRAZO_BASE_URL=https://api.correios.com.br/prazo

# JWT de login self-service de parceiro de API (POST /api/v1/login) — ver
# App\Support\Jwt\ApiPartnerJwt. Gere um valor aleatório longo (ex:
# `php artisan tinker --execute="echo Str::random(64);"`), dedicado (nunca
# reaproveitar APP_KEY). Sem valor, cai pra APP_KEY (funciona, mas perde o
# isolamento entre "token de API forjado" e "sessão web forjada").
API_PARTNER_JWT_SECRET=

VITE_APP_NAME="${APP_NAME}"
