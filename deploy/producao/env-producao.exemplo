# Modelo do /var/www/kazakora/shared/.env (produção). Os valores secretos
# vêm do homolog / painéis — NUNCA commitar o .env de verdade.
APP_NAME=KazaKora
APP_ENV=production
APP_DEBUG=false
APP_URL=https://kazakora.com
APP_KEY=            # php8.3 artisan key:generate --show
APP_TIMEZONE=America/Sao_Paulo
APP_LOCALE=pt_BR

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kazakora
DB_USERNAME=kazakora
DB_PASSWORD=        # está em /root/kazakora-credenciais.txt

# Redis em tudo que é rápido (pedido 2026-10-10).
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
QUEUE_CONNECTION=redis

MAIL_MAILER=smtp    # copiar do homolog
MAIL_FROM_ADDRESS="loja@kazakora.com"
MAIL_FROM_NAME="KazaKora"

# Mercado Pago: credenciais REAIS e modo teste desligado.
MERCADOPAGO_MODO_TESTE=false
# ...demais chaves (Mercado Pago, Mercado Livre, Shopee, Bling, NF-e,
# WhatsApp, Gemini) copiadas do .env do homolog.
