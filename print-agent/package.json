{
  "name": "kazakora-print-agent",
  "version": "1.0.0",
  "description": "Agente local (Windows) que busca etiquetas de envio pendentes na API da Kazakora e envia para a impressora térmica conectada, um job por vez, com fila persistente e retry automático.",
  "private": true,
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "poller": "node src/poller-process.js",
    "worker": "node src/worker-process.js",
    "dlq": "node src/dlq.js",
    "printers": "node src/list-printers.js"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "bullmq": "^5.12.0",
    "dotenv": "^16.4.5",
    "ioredis": "^5.4.1",
    "pdf-to-printer": "^5.6.0",
    "winston": "^3.14.2",
    "winston-daily-rotate-file": "^5.0.0"
  }
}
